[Unit]
Description=HPanel GitHub Remote Update Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/hpanel
ExecStart=/var/www/hpanel/deploy/poll.sh
StandardOutput=append:/var/log/hpanel-deploy.log
StandardError=append:/var/log/hpanel-deploy.log

[Install]
WantedBy=multi-user.target

